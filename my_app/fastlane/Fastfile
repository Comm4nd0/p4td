# Fastlane lanes for store screenshots and the App Store listing text.
#
# Pipeline:
#   1. ../tool/screenshots.sh         # capture raw PNGs into the layout below
#   2. fastlane upload_ios            # push the shots to App Store Connect
#   3. fastlane upload_android        # push the shots to Play Console
#
# Listing text (the App Store Connect version form) lives in git under
# fastlane/metadata/<locale>/*.txt:
#   fastlane download_metadata        # pull the live listing down into those files (once)
#   fastlane upload_metadata          # push the committed files back up (every release)
#
# Screenshots are uploaded plain (no device frames / no burned-in captions):
# frameit has no bezels for the captured emulator/simulator resolutions, so
# framing was removed. captions.strings is kept only as suggested store-listing
# copy you can paste into App Store Connect / Play Console by hand.
#
# Credentials (never commit these):
#   iOS:     App Store Connect API key — set via the env vars below.
#   Android: Play service-account JSON — path in SUPPLY_JSON_KEY.

IOS_BUNDLE_ID     = "uk.co.paws4thoughtdogs.paws4thoughtdogs"
ANDROID_PACKAGE   = "uk.co.paws4thoughtdogs.app"
LOCALE            = "en-GB"

METADATA_PATH     = File.expand_path("metadata", __dir__)
SCREENSHOTS_PATH  = File.expand_path("screenshots", __dir__)

# The `deliver` CLI (used by download_metadata) runs in its own process, so an
# in-process `app_store_connect_api_key` token wouldn't reach it. Write the JSON
# key file both the CLI and the action understand instead. Lives under keys/,
# which is gitignored.
def asc_api_key_file
  require "json"
  require "fileutils"
  path = File.expand_path("keys/asc_api_key.json", __dir__)
  FileUtils.mkdir_p(File.dirname(path))
  File.write(path, JSON.pretty_generate(
    "key_id"    => ENV.fetch("ASC_KEY_ID"),
    "issuer_id" => ENV.fetch("ASC_ISSUER_ID"),
    "key"       => File.read(ENV.fetch("ASC_KEY_PATH")),
    "in_house"  => false,
  ))
  path
end

# Marketing version from pubspec.yaml ("1.9.25+400" -> "1.9.25") so the listing
# is written against the version this commit actually ships. Override with
# APP_VERSION when you need to target a different one.
def marketing_version
  return ENV["APP_VERSION"] unless ENV["APP_VERSION"].to_s.empty?

  pubspec = File.read(File.expand_path("../pubspec.yaml", __dir__))
  match = pubspec.match(/^version:\s*(\d+\.\d+\.\d+)/)
  UI.user_error!("Could not read `version:` from my_app/pubspec.yaml") unless match
  match[1]
end

# The App Review demo login. App Review signs in with this, so `deliver` has to
# send it — but this repo is public, so the password can't be committed. The two
# files deliver reads it from are gitignored and written here instead, from the
# same DEMO_EMAIL / DEMO_PASSWORD secrets the screenshots workflow uses.
#
# Missing credentials are fatal rather than skipped: uploading with an empty demo
# account leaves App Review unable to sign in, which costs a rejection and a
# review cycle.
def write_review_credentials!
  require "fileutils"

  user = ENV["DEMO_EMAIL"].to_s
  pass = ENV["DEMO_PASSWORD"].to_s
  if user.empty? || pass.empty?
    UI.user_error!(
      "DEMO_EMAIL and DEMO_PASSWORD must be set — App Review signs in with them, " \
      "and they are deliberately not committed. See my_app/STORE_METADATA.md.",
    )
  end

  dir = File.join(METADATA_PATH, "review_information")
  FileUtils.mkdir_p(dir)
  File.write(File.join(dir, "demo_user.txt"), user)
  File.write(File.join(dir, "demo_password.txt"), pass)
  UI.message("Wrote the App Review demo login for #{user}")
end

default_platform(:ios)

platform :ios do
  lane :upload_ios do
    # Requires an App Store Connect API key. Provide it via env:
    #   ASC_KEY_ID, ASC_ISSUER_ID, ASC_KEY_PATH (path to the .p8)
    api_key = app_store_connect_api_key(
      key_id:      ENV.fetch("ASC_KEY_ID"),
      issuer_id:   ENV.fetch("ASC_ISSUER_ID"),
      key_filepath: ENV.fetch("ASC_KEY_PATH"),
    )
    deliver(
      api_key:               api_key,
      app_identifier:        IOS_BUNDLE_ID,
      # Screenshots can only attach to an EDITABLE version. When the latest
      # version is already released there is none, and deliver fails with
      # "Could not find a version to edit" — so name the version from
      # pubspec and let deliver create the draft when it has to. A draft
      # costs nothing; the next release edits the same one.
      app_version:           marketing_version,
      screenshots_path:      File.expand_path("screenshots", __dir__),
      skip_binary_upload:    true,
      skip_metadata:         true,
      overwrite_screenshots: true,
      run_precheck_before_submit: false,
      force:                 true, # no interactive HTML preview
    )
  end

  # ---------------------------------------------------------------------------
  # Listing text ("the form"): description, promo text, keywords, what's new,
  # URLs, review contact/demo account. Kept in git, pushed to App Store Connect.
  # ---------------------------------------------------------------------------

  # One-time (or whenever the live listing was edited by hand): pull the current
  # App Store listing down into fastlane/metadata/<locale>/*.txt, then commit it.
  lane :download_metadata do
    # Default to the *live* listing: there's usually no editable version sitting
    # in App Store Connect between releases. Set DOWNLOAD_EDIT_VERSION=1 to pull
    # from an in-progress version instead.
    live = ENV["DOWNLOAD_EDIT_VERSION"] == "1" ? "false" : "true"
    sh(
      "fastlane", "deliver", "download_metadata",
      "--app_identifier",    IOS_BUNDLE_ID,
      "--api_key_path",      asc_api_key_file,
      "--metadata_path",     METADATA_PATH,
      "--use_live_version",  live,
    )
    UI.success("Listing written to fastlane/metadata/ — review and commit it.")
  end

  # Every release: push the committed listing text to the version in pubspec.yaml,
  # creating that version in App Store Connect if it doesn't exist yet.
  # Nothing is submitted for review — you still press Submit in the web UI.
  #
  #   INCLUDE_SCREENSHOTS=1   also re-upload fastlane/screenshots/
  lane :upload_metadata do
    version = marketing_version
    listing = File.join(METADATA_PATH, LOCALE)
    unless Dir.exist?(listing)
      UI.user_error!("No listing at fastlane/metadata/#{LOCALE}/ — run `fastlane download_metadata` first.")
    end

    write_review_credentials!

    with_screenshots = ENV["INCLUDE_SCREENSHOTS"] == "1"
    UI.message("Uploading listing for #{version} (screenshots: #{with_screenshots})")

    deliver(
      api_key_path:            asc_api_key_file,
      app_identifier:          IOS_BUNDLE_ID,
      app_version:             version,
      metadata_path:           METADATA_PATH,
      screenshots_path:        SCREENSHOTS_PATH,
      skip_binary_upload:      true,
      skip_metadata:           false,
      skip_app_version_update: false,
      skip_screenshots:        !with_screenshots,
      overwrite_screenshots:   with_screenshots,
      submit_for_review:       false,
      run_precheck_before_submit: false,
      force:                   true, # no interactive HTML preview
    )
  end

  # ---------------------------------------------------------------------------
  # Shipping: attach the already-uploaded build to the version and send it to
  # App Review. Driven by the `Release iOS to App Store` workflow on a `v*` tag.
  # ---------------------------------------------------------------------------

  # This lane never builds or uploads a binary — Xcode Cloud archives and
  # uploads. Here we find the build for this release, attach it, and submit.
  #
  # Run `upload_metadata` first: the version has to exist and carry the right
  # listing text before a build can be attached to it.
  #
  # Which build? NOT pubspec's build number — Xcode Cloud stamps its own counter
  # into CFBundleVersion when it distributes (verified: run #525 arrived as build
  # 525 while pubspec said 401). That counter is shared across the product's
  # workflows, so it stays unique, but it has nothing to do with pubspec, which
  # only governs Android. So select by *version train* instead: the train for
  # this marketing version only ever holds builds of this release, because every
  # `my_app/` commit bumps the version. The highest one is the newest archive of
  # it.
  #
  #   SUBMIT=0        attach the build and stop (dry run — nothing sent to Apple)
  #   WAIT_MINUTES=n  how long to wait for a build to finish processing (30)
  #   APP_BUILD=n     attach this exact build instead of resolving one
  lane :submit_for_review do
    version = marketing_version
    submit  = ENV["SUBMIT"] != "0"

    api_key = app_store_connect_api_key(
      key_id:       ENV.fetch("ASC_KEY_ID"),
      issuer_id:    ENV.fetch("ASC_ISSUER_ID"),
      key_filepath: ENV.fetch("ASC_KEY_PATH"),
    )

    wait_minutes = (ENV["WAIT_MINUTES"] || "30").to_i

    build = ENV["APP_BUILD"].to_s
    if build.empty?
      # The archive for this commit normally exists well before anyone tags it,
      # but it can still be processing. Wait rather than fail immediately — and
      # fail readably rather than hanging.
      deadline = Time.now + (wait_minutes * 60)
      loop do
        latest = latest_testflight_build_number(
          api_key:              api_key,
          app_identifier:       IOS_BUNDLE_ID,
          version:              version,
          initial_build_number: 0,
        ).to_i

        if latest.positive?
          build = latest.to_s
          break
        end

        if Time.now > deadline
          UI.user_error!(
            "No build of #{version} appeared in TestFlight within #{wait_minutes} min. " \
            "Check that the Xcode Cloud archive for this commit finished and uploaded — " \
            "and that pubspec's version was bumped, since the train is keyed on it."
          )
        end
        UI.message("Waiting for a build of #{version} to finish processing…")
        sleep(60)
      end
    end

    # Having a build *number* only means the upload landed — App Store Connect
    # still has to process it, and attaching one mid-processing fails with
    # "The specified pre-release build could not be added" (v1.10.1 died here,
    # one second after resolving its build). Wait for the build itself, not just
    # its number. Same watcher pilot uses when it waits after an upload.
    app = Spaceship::ConnectAPI::App.find(IOS_BUNDLE_ID)
    UI.message("Waiting for build #{build} of #{version} to finish processing…")
    FastlaneCore::BuildWatcher.wait_for_build_processing_to_be_complete(
      app_id:            app.id,
      platform:          Spaceship::ConnectAPI::Platform::IOS,
      train_version:     version,
      build_version:     build,
      poll_interval:     30,
      timeout_duration:  wait_minutes * 60,
      return_spaceship_testflight_build: false,
    )

    UI.message("Attaching build #{build} to #{version} (submit for review: #{submit})")

    deliver(
      api_key_path:            asc_api_key_file,
      app_identifier:          IOS_BUNDLE_ID,
      app_version:             version,
      build_number:            build,
      # The listing was pushed by `upload_metadata`; don't re-send it here.
      skip_metadata:           true,
      skip_screenshots:        true,
      skip_binary_upload:      true,
      skip_app_version_update: false,
      submit_for_review:       submit,
      # Apple's approval doesn't put it in front of customers — releasing stays a
      # deliberate press in App Store Connect.
      automatic_release:       false,
      run_precheck_before_submit: false,
      force:                   true, # no interactive HTML preview
      submission_information: {
        # Info.plist already declares ITSAppUsesNonExemptEncryption=false, and
        # the app ships no ad or attribution SDK. Answering both here keeps the
        # submission from stopping on a prompt no one is there to answer.
        export_compliance_uses_encryption: false,
        add_id_info_uses_idfa:             false,
      },
    )
  end
end

platform :android do
  lane :upload_android do
    supply(
      package_name:           ANDROID_PACKAGE,
      json_key:               ENV.fetch("SUPPLY_JSON_KEY"), # Play service account
      metadata_path:          File.expand_path("metadata/android", __dir__),
      track:                  "alpha",
      skip_upload_apk:        true,
      skip_upload_aab:        true,
      skip_upload_metadata:   true,
      skip_upload_changelogs: true,
      skip_upload_images:     true,   # feature graphic / icon — not screenshots
      skip_upload_screenshots: false,
      validate_only:          false,
    )
  end
end

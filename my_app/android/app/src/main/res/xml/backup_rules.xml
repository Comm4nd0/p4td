<?xml version="1.0" encoding="utf-8"?>
<!-- Auto Backup rules for Android 11 and below. See the note above
     <application> in AndroidManifest.xml: flutter_secure_storage's files are
     unreadable on any phone but the one that wrote them. -->
<full-backup-content>
    <exclude domain="sharedpref" path="FlutterSecureStorage.xml" />
    <exclude domain="sharedpref" path="FlutterSecureKeyStorage.xml" />
</full-backup-content>

# Keep secrets, local state, and the (unrelated) Flutter app out of the image
# build context — smaller, faster builds and no accidental secret leakage.

# Secrets / environment
.env
.env.*

# Version control
.git

# Local databases
*.sqlite3

# Database dumps. scripts/backup-db.sh defaults BACKUP_DIR to <repo>/backups, so
# without this every pg_dump would be copied into the image by the `COPY . .` in
# the Dockerfile.
backups/

# Runtime / generated data (mounted as volumes in prod)
media/
staticfiles/

# Vaccination certificates. Bind-mounted at runtime like media/, but unlike
# media/ this was missing here, so `COPY . .` baked every certificate into
# every image built on the server: copies that outlived the originals when a
# client deleted one or closed their account, and a full extra set per deploy
# on a disk shared with Postgres.
private-media/

# Server-side state that sits in the checkout and has no business in an image.
.deploy-history
*.log
migration-data/

# CI and deploy tooling: runs on the host or in GitHub, never in the container.
.github/

# Flutter mobile app (built and deployed separately)
my_app/

# Python virtualenvs and caches
venv/
__pycache__/
*.pyc

# Tooling / editor state
.claude/
node_modules/

# NOT listed, on purpose: the Firebase service-account JSON. Push notifications
# read it from the path in FIREBASE_SERVICE_ACCOUNT_KEY, and the compose file
# mounts nothing for it — so if that path is inside this checkout, the copy in
# the image is the only one the container can see. Excluding it here would
# silently stop every push on the next deploy. See DEPLOYMENT.md ("Firebase
# key") for moving it to a mount first.

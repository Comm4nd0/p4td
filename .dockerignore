# Keep secrets, local state, and the (unrelated) Flutter app out of the image
# build context — smaller, faster builds and no accidental secret leakage.

# Secrets / environment
.env
.env.*

# Version control
.git

# Local databases
*.sqlite3

# Database dumps. scripts/backup-db.sh defaults BACKUP_DIR to <repo>/backups, so
# without this every pg_dump would be copied into the image by the `COPY . .` in
# the Dockerfile.
backups/

# Runtime / generated data (mounted as volumes in prod)
media/
staticfiles/

# Flutter mobile app (built and deployed separately)
my_app/

# Python virtualenvs and caches
venv/
__pycache__/
*.pyc

# Tooling / editor state
.claude/
node_modules/
